config BR2_PACKAGE_ROCKCHIP_RKNN
	bool "Rockchip RV1103/RV1106 neural runtime"
	depends on BR2_arm && BR2_ARM_EABIHF && BR2_TOOLCHAIN_USES_MUSL
	depends on BR2_TOOLCHAIN_HAS_THREADS && BR2_USE_MMU
	select BR2_PACKAGE_LIBDRM
	help
	  Pinned RKNN mini runtime for the RV1103/RV1106 NPU, with the small
	  C-library compatibility layer needed by this musl image.

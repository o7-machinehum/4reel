From: 4reel <noreply@4reel.local>
Subject: [PATCH] use independently licensed sse2neon on ARM

The bundled ad-hoc NEON shim has no explicit license grant and its
_mm_mullo_epi16 implementation is not equivalent to SSE. Use the pinned,
MIT-licensed sse2neon header supplied by the Buildroot package instead.

--- a/libviso2/libviso2/src/matcher.h
+++ b/libviso2/libviso2/src/matcher.h
@@ -28,7 +28,7 @@
 #include <fstream>
 #include <math.h>
 #if defined(__ARM_NEON__)
-#include "sse_to_neon.hpp"
+#include "sse2neon.h"
 #else
 #include <emmintrin.h>
 #endif
--- a/libviso2/libviso2/src/filter.h
+++ b/libviso2/libviso2/src/filter.h
@@ -23,7 +23,7 @@
 #define __FILTER_H__
 
 #if defined(__ARM_NEON__)
-#include "sse_to_neon.hpp"
+#include "sse2neon.h"
 #else
 #include <emmintrin.h>
 #include <pmmintrin.h>

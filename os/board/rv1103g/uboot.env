bootdelay=1
kernel_addr_r=0x00800000
fdt_addr_r=0x00600000
bootargs=console=ttyS2,115200n8 earlycon=uart8250,mmio32,0xff4c0000 root=/dev/mmcblk0p2 rootfstype=ext4 rootwait rw
bootcmd=mmc dev 0; if fatload mmc 0:1 ${kernel_addr_r} zImage; then if fatload mmc 0:1 ${fdt_addr_r} rv1103g-4reel.dtb; then bootz ${kernel_addr_r} - ${fdt_addr_r}; fi; fi

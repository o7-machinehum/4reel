From 7a704a2ae488717428253388ee7885cb25511bc2 Mon Sep 17 00:00:00 2001
From: machinehum <machinehum@users.noreply.github.com>
Date: Thu, 24 Sep 2026 12:00:00 +0200
Subject: [PATCH] media: i2c: ov9281: honor 180-degree rotation

Allow a board to describe an upside-down OV9281 with the standard rotation
property. Toggle both sensor orientation bits after applying the mode table so
the setting is restored on every stream start and applies to all consumers.

Signed-off-by: machinehum <machinehum@users.noreply.github.com>
---
 drivers/media/i2c/ov9281.c | 56 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/drivers/media/i2c/ov9281.c b/drivers/media/i2c/ov9281.c
index 03548dcc37de..5773245a29ca 100644
--- a/drivers/media/i2c/ov9281.c
+++ b/drivers/media/i2c/ov9281.c
@@ -42,6 +42,10 @@
 #define OV9281_MODE_SW_STANDBY		0x0
 #define OV9281_MODE_STREAMING		BIT(0)
 
+#define OV9281_REG_TIMING_FORMAT_1	0x3820
+#define OV9281_REG_TIMING_FORMAT_2	0x3821
+#define OV9281_FLIP_BIT			BIT(2)
+
 #define OV9281_REG_EXPOSURE		0x3500
 #define	OV9281_EXPOSURE_MIN		4
 #define	OV9281_EXPOSURE_STEP		1
@@ -164,6 +168,7 @@ struct ov9281 {
 	bool			is_thunderboot;
 	bool			is_thunderboot_ng;
 	bool			is_first_streamoff;
+	bool			rotate_180;
 	const struct ov9281_mode *cur_mode;
 	u32			module_index;
 	const char		*module_facing;
@@ -759,6 +764,45 @@ static long ov9281_compat_ioctl32(struct v4l2_subdev *sd,
 }
 #endif
 
+static int ov9281_apply_rotation(struct ov9281 *ov9281)
+{
+	const struct regval *regs = ov9281->cur_mode->reg_list;
+	u8 format1 = 0;
+	u8 format2 = 0;
+	bool found1 = false;
+	bool found2 = false;
+	u32 i;
+	int ret;
+
+	if (!ov9281->rotate_180)
+		return 0;
+
+	for (i = 0; regs[i].addr != REG_NULL; i++) {
+		if (regs[i].addr == OV9281_REG_TIMING_FORMAT_1) {
+			format1 = regs[i].val;
+			found1 = true;
+		} else if (regs[i].addr == OV9281_REG_TIMING_FORMAT_2) {
+			format2 = regs[i].val;
+			found2 = true;
+		}
+	}
+
+	if (!found1 || !found2)
+		return -EINVAL;
+
+	ret = ov9281_write_reg(ov9281->client,
+				OV9281_REG_TIMING_FORMAT_1,
+				OV9281_REG_VALUE_08BIT,
+				format1 ^ OV9281_FLIP_BIT);
+	if (ret)
+		return ret;
+
+	return ov9281_write_reg(ov9281->client,
+				OV9281_REG_TIMING_FORMAT_2,
+				OV9281_REG_VALUE_08BIT,
+				format2 ^ OV9281_FLIP_BIT);
+}
+
 static int __ov9281_start_stream(struct ov9281 *ov9281)
 {
 	int ret;
@@ -770,5 +814,9 @@ static int __ov9281_start_stream(struct ov9281 *ov9281)
 			return ret;
 	}
+	ret = ov9281_apply_rotation(ov9281);
+	if (ret)
+		return ret;
+
 	/* In case these controls are set before streaming */
 	mutex_unlock(&ov9281->mutex);
 	ret = v4l2_ctrl_handler_setup(&ov9281->ctrl_handler);
@@ -1270,6 +1318,7 @@ static int ov9281_probe(struct i2c_client *client,
 	struct ov9281 *ov9281;
 	struct v4l2_subdev *sd;
 	char facing[2];
+	u32 rotation = 0;
 	int ret;
 
 	dev_info(dev, "driver version: %02x.%02x.%02x",
@@ -1282,6 +1331,13 @@ static int ov9281_probe(struct i2c_client *client,
 	if (!ov9281)
 		return -ENOMEM;
 
+	of_property_read_u32(node, "rotation", &rotation);
+	if (rotation != 0 && rotation != 180) {
+		dev_err(dev, "unsupported rotation %u\n", rotation);
+		return -EINVAL;
+	}
+	ov9281->rotate_180 = rotation == 180;
+
 	ret = of_property_read_u32(node, RKMODULE_CAMERA_MODULE_INDEX,
 				   &ov9281->module_index);
 	ret |= of_property_read_string(node, RKMODULE_CAMERA_MODULE_FACING,
-- 

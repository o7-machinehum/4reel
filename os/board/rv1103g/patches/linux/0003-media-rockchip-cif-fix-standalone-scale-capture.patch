From: 4reel contributors
Subject: [PATCH] media: rockchip: cif: fix standalone scale capture

Initialize the backing CSI stream from the sensor format, start the source
without full-resolution DMA, and handle shared scaler IRQs across CSI hosts.
Also fix monochrome strides and failure cleanup.

---
diff --git a/drivers/media/platform/rockchip/cif/cif-scale.c b/drivers/media/platform/rockchip/cif/cif-scale.c
--- a/drivers/media/platform/rockchip/cif/cif-scale.c
+++ b/drivers/media/platform/rockchip/cif/cif-scale.c
@@ -212,6 +212,9 @@
 		case V4L2_PIX_FMT_SGRBG8:
 		case V4L2_PIX_FMT_SGBRG8:
 		case V4L2_PIX_FMT_SBGGR8:
+		case V4L2_PIX_FMT_GREY:
+		case V4L2_PIX_FMT_Y10:
+		case V4L2_PIX_FMT_Y12:
 		case V4L2_PIX_FMT_SRGGB10:
 		case V4L2_PIX_FMT_SGRBG10:
 		case V4L2_PIX_FMT_SGBRG10:
@@ -300,6 +303,18 @@
 		}
 		scale_vdev->src_res.width = fmt_src.format.width;
 		scale_vdev->src_res.height = fmt_src.format.height;
+		if (!try && stream->cur_stream_mode == RKCIF_STREAM_MODE_NONE &&
+		    !vb2_is_busy(&stream->vnode.buf_queue)) {
+			struct v4l2_pix_format_mplane source_pixm = { 0 };
+
+			source_pixm.pixelformat =
+				rkcif_mbus_pixelcode_to_v4l2(fmt_src.format.code);
+			source_pixm.width = fmt_src.format.width;
+			source_pixm.height = fmt_src.format.height;
+			ret = rkcif_set_fmt(stream, &source_pixm, false);
+			if (ret)
+				return ret;
+		}
 	}
 	fmt = rkcif_scale_find_output_fmt(pixm->pixelformat);
 	if (fmt == NULL) {
@@ -889,8 +904,7 @@
 		list_del(&buf->queue);
 		vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_ERROR);
 	}
-	if (scale_vdev->scl_mode != RKCIF_SCL_MODE_SCALE)
-		rkcif_do_stop_stream(stream, RKCIF_STREAM_MODE_TOSCALE);
+	rkcif_do_stop_stream(stream, RKCIF_STREAM_MODE_TOSCALE);
 
 	scale_vdev->cur_stream_mode &= ~mode;
 end_stop_scale:
@@ -1281,6 +1295,9 @@
 	else
 		ret = rkcif_scale_channel_set(scale_vdev);
 
+	if (ret)
+		return ret;
+
 	scale_vdev->frame_idx = 0;
 	scale_vdev->state = RKCIF_STATE_STREAMING;
 
@@ -1298,7 +1315,8 @@
 	if (scale_vdev->state == RKCIF_STATE_STREAMING) {
 		ret = -EBUSY;
 		v4l2_err(v4l2_dev, "scale stream in busy state\n");
-		goto destroy_buf;
+		mutex_unlock(&dev->scale_lock);
+		return ret;
 	}
 
 	scale_vdev->cur_stream_mode = mode;
@@ -1306,19 +1324,25 @@
 	if (ret)
 		goto destroy_buf;
 
-	if (scale_vdev->scl_mode != RKCIF_SCL_MODE_SCALE)
-		rkcif_do_start_stream(stream, RKCIF_STREAM_MODE_TOSCALE);
+	ret = rkcif_do_start_stream(stream, RKCIF_STREAM_MODE_TOSCALE);
+	if (ret)
+		goto destroy_buf;
 
 	mutex_unlock(&dev->scale_lock);
 	return 0;
 
 destroy_buf:
+	if (scale_vdev->state == RKCIF_STATE_STREAMING)
+		rkcif_scale_stop(scale_vdev);
+	scale_vdev->cur_stream_mode &= ~mode;
 	if (scale_vdev->next_buf)
 		vb2_buffer_done(&scale_vdev->next_buf->vb.vb2_buf,
 				VB2_BUF_STATE_QUEUED);
 	if (scale_vdev->curr_buf)
 		vb2_buffer_done(&scale_vdev->curr_buf->vb.vb2_buf,
 				VB2_BUF_STATE_QUEUED);
+	scale_vdev->curr_buf = NULL;
+	scale_vdev->next_buf = NULL;
 	while (!list_empty(&scale_vdev->buf_head)) {
 		struct rkcif_buffer *buf;
 
@@ -1485,6 +1509,7 @@
 	int ch;
 	int i = 0;
 	u32 val = 0;
+	u32 frame_phase;
 
 	if (cif_dev->chip_id < CHIP_RK3576_CIF)
 		val = SCALE_FIFO_OVERFLOW(0) |
@@ -1507,7 +1532,15 @@
 	for (i = 0; i < RKCIF_MAX_STREAM_MIPI; i++) {
 		ch = rkcif_scale_g_ch(cif_dev, intstat_glb);
 		if (ch < 0)
-			continue;
+			break;
+
+		if (cif_dev->chip_id < CHIP_RK3576_CIF) {
+			frame_phase = SW_SCALE_END(intstat_glb, ch);
+			intstat_glb &= ~SCALE_END_INTSTAT(ch);
+		} else {
+			frame_phase = SW_SCALE_END_RK3576(intstat_glb);
+			intstat_glb &= ~SCALE_END_INTSTAT_RK3576;
+		}
 
 		scale_vdev = &cif_dev->scale_vdev[ch];
 
@@ -1521,13 +1554,7 @@
 			continue;
 		}
 
-		if (cif_dev->chip_id < CHIP_RK3576_CIF) {
-			scale_vdev->frame_phase = SW_SCALE_END(intstat_glb, ch);
-			intstat_glb &= ~(SCALE_END_INTSTAT(ch));
-		} else {
-			scale_vdev->frame_phase = SW_SCALE_END_RK3576(intstat_glb);
-			intstat_glb &= ~(SCALE_END_INTSTAT_RK3576);
-		}
+		scale_vdev->frame_phase = frame_phase;
 		rkcif_scale_update_stream(scale_vdev, ch);
 		stream = scale_vdev->stream;
 		if (stream->to_en_dma)

// Render: python3 scripts/render_overview.py
// Part numbers: rv1103/out/r0.1/fab/bom.csv.
// Clock and RAM follow the project's Linux device tree.
graph board {
  graph [layout=neato, bgcolor="white", pad=0.25, splines=ortho, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=14,
        fixedsize=true, width=2.7, height=0.8, color="#94a3b8", fillcolor="#f1f5f9", penwidth=1.3];
  edge [color="#64748b", penwidth=1.6];

  cpu [pos="310,0!", width=3.0, height=5.0,
       label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><B>RV1103</B></TD></TR><TR><TD HEIGHT="12"></TD></TR><TR><TD>Cortex-A7 · 1.1 GHz</TD></TR><TR><TD>64 MB RAM</TD></TR><TR><TD HEIGHT="16"></TD></TR><TR><TD FIXEDSIZE="TRUE" WIDTH="180" HEIGHT="105"><IMG SRC="img/tux.png" SCALE="TRUE"/></TD></TR></TABLE>>,
       fontsize=17, color="#2563eb", fillcolor="#dbeafe", penwidth=2];

  camera1 [pos="0,144!", label=<<B>OV9281</B><BR/>Global-shutter camera>, color="#0d9488", fillcolor="#e0f2ee"];
  camera2 [pos="0,72!", label=<<B>OV9281</B><BR/>Global-shutter camera>, color="#0d9488", fillcolor="#e0f2ee"];
  accel [pos="0,0!", label=<<B>LIS2HH12</B><BR/>3-axis accelerometer>, color="#0d9488", fillcolor="#e0f2ee"];
  flash [pos="0,-72!", label=<<B>W25Q32JVZP</B><BR/>4 MB flash memory>, color="#a78bfa", fillcolor="#ede9fe"];
  sd [pos="0,-144!", label="microSD", color="#a78bfa", fillcolor="#ede9fe"];

  ethernet [pos="620,108!", label=<Ethernet · 10/100 Mb/s<BR/><B>HR911105A</B> RJ45>, color="#d99a37", fillcolor="#fff3df"];
  usb [pos="620,0!", label="USB-C", color="#d99a37", fillcolor="#fff3df"];
  uart [pos="620,-108!", label="UART port", color="#d99a37", fillcolor="#fff3df"];

  camera1:e -- cpu:w;
  camera2:e -- cpu:w;
  accel:e -- cpu:w;
  flash:e -- cpu:w;
  sd:e -- cpu:w;
  cpu:e -- ethernet:w;
  cpu:e -- usb:w;
  cpu:e -- uart:w;
}
